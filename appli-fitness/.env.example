# Copier en .env  ->  ces variables sont lues au build par app.config.ts.
# Ce sont des cles PUBLIQUES (elles finissent dans le bundle de l'app) :
# aucune cle secrete ne doit figurer ici.

EXPO_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# RevenueCat : cles publiques SDK (une par plateforme)
EXPO_PUBLIC_REVENUECAT_IOS=appl_xxxxxxxxxxxx
EXPO_PUBLIC_REVENUECAT_ANDROID=goog_xxxxxxxxxxxx

# Mettre a 1 pour deverrouiller tous les paliers pendant le developpement
# (spec : "commencer par une version ou TOUT est debloque").
EXPO_PUBLIC_TOUT_DEBLOQUE=1
