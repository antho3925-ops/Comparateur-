{
  "name": "appli-fitness",
  "version": "0.1.0",
  "main": "expo-router/entry",
  "private": true,
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "verif-types": "tsc --noEmit && tsc -p tests --noEmit",
    "test": "node --test tests/*.test.ts",
    "build:test": "eas build --profile developpement",
    "build:store": "eas build --profile production --platform all"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "3.1.1",
    "@supabase/supabase-js": "2.116.0",
    "expo": "~57.0.21",
    "expo-apple-authentication": "57.0.1",
    "expo-camera": "57.0.4",
    "expo-file-system": "57.0.6",
    "expo-image-manipulator": "57.0.16",
    "expo-linking": "57.0.9",
    "expo-router": "57.0.20",
    "expo-status-bar": "~57.0.1",
    "expo-web-browser": "57.0.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-native": "0.86.3",
    "react-native-purchases": "10.9.0",
    "react-native-safe-area-context": "5.9.1",
    "react-native-screens": "4.27.0",
    "react-native-url-polyfill": "4.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.5.0",
    "@types/react": "~19.2.2",
    "typescript": "~6.0.3"
  }
}
