---
// Page de présentation de l'entreprise.
import Base from '../layouts/Base.astro';
import Pic from '../components/Pic.astro';
import Text from '../components/Text.astro';
import Coords from '../components/Coords.astro';
import Icon from '../components/Icon.astro';
import { ui } from '../i18n/ui.js';
import { href } from '../lib/routes.js';
import p from '../content/presentation.json';
import site from '../content/site.json';

interface Props { lang: 'fr' | 'es'; }
const { lang } = Astro.props;
const t = ui[lang];
const meta = {
  fr: { title: 'Présentation', description: "Découvrez JON'ART SRL, entreprise de finitions et de rénovation intérieure dirigée par Jonathan Tinoco, à Linkebeek (Bruxelles) et en Espagne." },
  es: { title: 'Quiénes somos', description: 'Conozca JON\'ART SRL, empresa de acabados y reforma interior dirigida por Jonathan Tinoco, en Bruselas y en España.' },
}[lang];
---
<Base lang={lang} page="presentation" title={meta.title} description={meta.description}>
  <header class="page-hero">
    <div class="wrap">
      <p class="eyebrow">{t.nav.presentation}</p>
      <h1>{p.titre[lang]}</h1>
      <p class="lead">« {lang === 'fr' ? "L'art de la construction" : 'El arte de la construcción'} »</p>
    </div>
  </header>

  <section class="section">
    <div class="wrap two-cols">
      <div>
        <p class="lead" style="color:var(--ink)"><Text value={p.intro[lang]} /></p>
        {p.paragraphes.map((para) => <p><Text value={para[lang]} /></p>)}
        <p><strong>{lang === 'fr' ? 'Gérant' : 'Gerente'} :</strong> {site.gerant}</p>
        <div class="actions" style="margin-top:2rem">
          <a class="btn btn--navy" href={href('devis', lang)}>{t.ctaDevis} <Icon name="arrow" /></a>
          <a class="btn btn--ghost" href={href('realisations', lang)}>{t.ctaRealisations}</a>
        </div>
      </div>
      <div class="framed">
        <Pic src={p.image} alt={p.alt[lang]} lang={lang} sizes="(min-width: 900px) 40vw, 100vw" />
      </div>
    </div>
  </section>

  <section class="section section--beige" aria-labelledby="titre-etapes">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">{t.sections.etapes}</p>
        <h2 id="titre-etapes">{lang === 'fr' ? 'Un chantier clair, du premier appel à la réception' : 'Una obra clara, de la primera llamada a la entrega'}</h2>
      </div>
      <ol class="steps">
        {p.etapes.map((e) => <li><h3>{e.titre[lang]}</h3><p><Text value={e.texte[lang]} /></p></li>)}
      </ol>
    </div>
  </section>

  <section class="section" aria-labelledby="titre-zones">
    <div class="wrap contact-grid">
      <div>
        <p class="eyebrow">{t.sections.zones}</p>
        <h2 id="titre-zones">{lang === 'fr' ? 'Belgique et Espagne' : 'Bélgica y España'}</h2>
      </div>
      <Coords lang={lang} />
    </div>
  </section>
</Base>
